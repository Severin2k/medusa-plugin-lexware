    "type": "git",
    "url": ""
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.10.0"
  },
  "dependencies": {
    "nodemailer": "^8.0.4"
  },
  "devDependencies": {
    "@medusajs/framework": "^2.13.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^7.0.11",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "jest": "^29.7.0",
