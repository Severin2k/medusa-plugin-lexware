{
  "name": "medusa-lexbridge",
  "version": "1.0.0",
  "description": "Lexware Office integration for Medusa v2 - automatic invoices, contact management, PDF delivery, credit notes, and more.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/admin"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "medusa",
    "medusa-plugin",
    "medusa-v2",
    "lexware",
    "lexware-office",
    "lexoffice",
    "invoice",
    "accounting",
    "rechnung",
    "buchhaltung",
    "erp",
    "german-tax"
  ],
  "author": "Blumen Komander GbR <info@lexbridge.shop>",
  "license": "MIT",
  "homepage": "https://lexbridge.shop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Severin2k/medusa-plugin-lexware.git"
  },
  "bugs": {
    "url": "https://github.com/Severin2k/medusa-plugin-lexware/issues"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.10.0"
  },
  "dependencies": {
    "nodemailer": "^8.0.4"
  },
  "devDependencies": {
    "@medusajs/framework": "^2.13.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^7.0.11",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
