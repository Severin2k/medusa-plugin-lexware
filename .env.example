# Lexware Office API Key
LEXWARE_API_KEY=your_lexware_api_key_here

# Email for error notifications (optional)
LEXWARE_NOTIFICATION_EMAIL=info@example.com

# Encryption Key for API Key storage (32 Bytes as hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEXWARE_ENCRYPTION_KEY=

# SMTP Configuration (required for sending invoice PDFs)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your_password
